<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CCW 450A Training Standard Quiz — U5700, U5703.0 & U5706.0</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --card-alt: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #f59e0b;
      --accent-hover: #d97706;
      --correct: #10b981;
      --correct-bg: rgba(16, 185, 129, 0.15);
      --wrong: #ef4444;
      --wrong-bg: rgba(239, 68, 68, 0.15);
      --border: #475569;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.5;
      padding: 1.25rem;
      min-height: 100vh;
    }

    .app-container {
      max-width: 960px;
      margin: 0 auto;
    }

    /* Header & Scoreboard */
    header {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem;
      margin-bottom: 1rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .header-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .title-group h1 {
      font-size: 1.25rem;
      color: var(--accent);
      letter-spacing: 0.02em;
    }

    .title-group p {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .score-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .pill {
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 0.4rem 0.75rem;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
    }

    .pill span {
      color: var(--accent);
    }

    /* Progress Bar */
    .progress-track {
      width: 100%;
      height: 8px;
      background: var(--bg);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 1rem;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--correct));
      width: 0%;
      transition: width 0.3s ease;
    }

    /* Unit Filter Tabs */
    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tab-btn {
      background: var(--bg);
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 0.5rem 0.9rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .tab-btn:hover {
      color: var(--text);
      border-color: var(--accent);
    }

    .tab-btn.active {
      background: var(--accent);
      color: #0f172a;
      border-color: var(--accent);
    }

    /* Slide Card */
    .slide-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 1rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .slide-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .badge-group {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      text-transform: uppercase;
    }

    .badge-unit {
      background: rgba(245, 158, 11, 0.2);
      color: var(--accent);
      border: 1px solid var(--accent);
    }

    .badge-skill {
      background: var(--card-alt);
      color: var(--text);
    }

    .slide-counter {
      font-size: 0.85rem;
      color: var(--muted);
      font-weight: 600;
    }

    .question-text {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
      color: var(--text);
    }

    /* Options */
    .options-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .option-btn {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      width: 100%;
      text-align: left;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.9rem 1rem;
      border-radius: 10px;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .option-btn:hover:not(:disabled) {
      border-color: var(--accent);
      background: rgba(245, 158, 11, 0.08);
    }

    .option-btn:disabled {
      cursor: default;
    }

    .opt-letter {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 28px;
      height: 28px;
      border-radius: 6px;
      background: var(--card-alt);
      color: var(--text);
      font-weight: 700;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .option-btn.correct {
      border-color: var(--correct);
      background: var(--correct-bg);
    }

    .option-btn.correct .opt-letter {
      background: var(--correct);
      color: #06281e;
    }

    .option-btn.wrong {
      border-color: var(--wrong);
      background: var(--wrong-bg);
    }

    .option-btn.wrong .opt-letter {
      background: var(--wrong);
      color: #fff;
    }

    /* Rationale / Self-Correction Box */
    .rationale-box {
      margin-top: 1.25rem;
      padding: 1rem 1.15rem;
      border-radius: 10px;
      border-left: 4px solid var(--accent);
      background: rgba(15, 23, 42, 0.75);
      display: none;
    }

    .rationale-box.visible {
      display: block;
    }

    .rationale-status {
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 0.35rem;
    }

    .rationale-status.pass {
      color: var(--correct);
    }

    .rationale-status.fail {
      color: var(--wrong);
    }

    .rationale-text {
      font-size: 0.92rem;
      color: #e2e8f0;
      margin-bottom: 0.75rem;
    }

    /* Controls Bar */
    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }

    .nav-btn, .action-btn {
      padding: 0.6rem 1.1rem;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid var(--border);
      background: var(--card-alt);
      color: var(--text);
      transition: all 0.2s;
    }

    .nav-btn:hover:not(:disabled), .action-btn:hover {
      border-color: var(--accent);
      background: var(--accent);
      color: #0f172a;
    }

    .nav-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .action-btn.retry-slide {
      background: transparent;
      border-color: var(--accent);
      color: var(--accent);
    }

    .action-btn.retry-slide:hover {
      background: var(--accent);
      color: #0f172a;
    }

    /* Slide Navigator Grid */
    .grid-panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem;
    }

    .grid-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }

    .grid-header h2 {
      font-size: 0.95rem;
      color: var(--muted);
    }

    .question-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
      gap: 0.45rem;
    }

    .grid-dot {
      height: 36px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--muted);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }

    .grid-dot:hover {
      border-color: var(--accent);
      color: var(--text);
    }

    .grid-dot.current {
      outline: 2px solid var(--accent);
      color: var(--text);
    }

    .grid-dot.answered-correct {
      background: var(--correct-bg);
      border-color: var(--correct);
      color: var(--correct);
    }

    .grid-dot.answered-wrong {
      background: var(--wrong-bg);
      border-color: var(--wrong);
      color: var(--wrong);
    }

    .empty-state {
      text-align: center;
      padding: 2rem 1rem;
      color: var(--muted);
    }
  </style>
</head>
