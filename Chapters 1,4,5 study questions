    const STORAGE_KEY = "ccw_450a_u5700_u5703_u5706_responses_v1";
    let userResponses = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    let activeFilter = "ALL";
    let currentSlideIndex = 0;

    const LETTERS = ["A", "B", "C", "D"];

    function getFilteredQuestions() {
      if (activeFilter === "ALL") return QUESTIONS;
      if (activeFilter === "MISSED") {
        return QUESTIONS.filter(q => userResponses[q.id] !== undefined && userResponses[q.id] !== q.answer);
      }
      return QUESTIONS.filter(q => q.unit === activeFilter);
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(userResponses));
    }

    function updateScoreboard() {
      const answeredIds = Object.keys(userResponses);
      let totalCorrect = 0;
      let u5700Correct = 0, u5703Correct = 0, u5706Correct = 0;

      QUESTIONS.forEach(q => {
        if (userResponses[q.id] === q.answer) {
          totalCorrect++;
          if (q.unit === "U5700.0") u5700Correct++;
          if (q.unit === "U5703.0") u5703Correct++;
          if (q.unit === "U5706.0") u5706Correct++;
        }
      });

      const pct = answeredIds.length > 0 ? Math.round((totalCorrect / answeredIds.length) * 100) : 0;
      document.getElementById("total-score").textContent = `${totalCorrect} / ${answeredIds.length} (${pct}%)`;
      document.getElementById("u5700-score").textContent = `${u5700Correct}/20`;
      document.getElementById("u5703-score").textContent = `${u5703Correct}/20`;
      document.getElementById("u5706-score").textContent = `${u5706Correct}/20`;

      const progressPct = (answeredIds.length / QUESTIONS.length) * 100;
      document.getElementById("progress-fill").style.width = `${progressPct}%`;
    }

    function renderSlide() {
      const filtered = getFilteredQuestions();
      const container = document.getElementById("slide-container");

      if (filtered.length === 0) {
        document.getElementById("unit-badge").textContent = "COMPLETE";
        document.getElementById("skill-badge").textContent = "No Missed Questions";
        document.getElementById("slide-counter").textContent = "0 of 0";
        document.getElementById("question-text").textContent = "You currently have no missed questions in this view! Answer more questions or switch back to All Questions.";
        document.getElementById("options-list").innerHTML = "";
        document.getElementById("rationale-box").classList.remove("visible");
        document.getElementById("prev-btn").disabled = true;
        document.getElementById("next-btn").disabled = true;
        renderGrid(filtered);
        updateScoreboard();
        return;
      }

      if (currentSlideIndex >= filtered.length) currentSlideIndex = filtered.length - 1;
      if (currentSlideIndex < 0) currentSlideIndex = 0;

      const currentQ = filtered[currentSlideIndex];
      const selectedChoice = userResponses[currentQ.id];
      const isAnswered = selectedChoice !== undefined;

      document.getElementById("unit-badge").textContent = currentQ.unit;
      document.getElementById("skill-badge").textContent = currentQ.skill;
      document.getElementById("slide-counter").textContent = `Slide ${currentSlideIndex + 1} of ${filtered.length} (Q#${currentQ.id})`;
      document.getElementById("question-text").textContent = currentQ.q;

      const optionsList = document.getElementById("options-list");
      optionsList.innerHTML = "";

      currentQ.options.forEach((optText, idx) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        if (isAnswered) {
          btn.disabled = true;
          if (idx === currentQ.answer) btn.classList.add("correct");
          else if (idx === selectedChoice && selectedChoice !== currentQ.answer) btn.classList.add("wrong");
        }
        btn.innerHTML = `<span class="opt-letter">${LETTERS[idx]}</span><span>${optText}</span>`;
        btn.addEventListener("click", () => selectOption(currentQ.id, idx));
        optionsList.appendChild(btn);
      });

      const rationaleBox = document.getElementById("rationale-box");
      const rationaleStatus = document.getElementById("rationale-status");
      const rationaleText = document.getElementById("rationale-text");

      if (isAnswered) {
        rationaleBox.classList.add("visible");
        if (selectedChoice === currentQ.answer) {
          rationaleStatus.textContent = "✓ Correct!";
          rationaleStatus.className = "rationale-status pass";
        } else {
          rationaleStatus.textContent = `✗ Incorrect — You chose ${LETTERS[selectedChoice]}. Correct Answer: ${LETTERS[currentQ.answer]}`;
          rationaleStatus.className = "rationale-status fail";
        }
        rationaleText.textContent = currentQ.rationale;
      } else {
        rationaleBox.classList.remove("visible");
      }

      document.getElementById("prev-btn").disabled = currentSlideIndex === 0;
      document.getElementById("next-btn").disabled = currentSlideIndex === filtered.length - 1;

      renderGrid(filtered);
      updateScoreboard();
    }

    function renderGrid(filtered) {
      const grid = document.getElementById("question-grid");
      grid.innerHTML = "";
      filtered.forEach((q, idx) => {
        const btn = document.createElement("button");
        btn.className = "grid-dot";
        btn.textContent = q.id;
        if (idx === currentSlideIndex) btn.classList.add("current");
        if (userResponses[q.id] !== undefined) {
          if (userResponses[q.id] === q.answer) btn.classList.add("answered-correct");
          else btn.classList.add("answered-wrong");
        }
        btn.addEventListener("click", () => {
          currentSlideIndex = idx;
          renderSlide();
        });
        grid.appendChild(btn);
      });
    }

    function selectOption(questionId, optionIdx) {
      userResponses[questionId] = optionIdx;
      saveState();
      renderSlide();
    }

    // Event Listeners
    document.getElementById("prev-btn").addEventListener("click", () => {
      if (currentSlideIndex > 0) {
        currentSlideIndex--;
        renderSlide();
      }
    });

    document.getElementById("next-btn").addEventListener("click", () => {
      const filtered = getFilteredQuestions();
      if (currentSlideIndex < filtered.length - 1) {
        currentSlideIndex++;
        renderSlide();
      }
    });

    document.getElementById("retry-slide-btn").addEventListener("click", () => {
      const filtered = getFilteredQuestions();
      if (!filtered[currentSlideIndex]) return;
      delete userResponses[filtered[currentSlideIndex].id];
      saveState();
      renderSlide();
    });

    document.getElementById("reset-all-btn").addEventListener("click", () => {
      if (confirm("Reset all saved scores and answers across all 60 questions?")) {
        userResponses = {};
        saveState();
        currentSlideIndex = 0;
        renderSlide();
      }
    });

    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeFilter = btn.getAttribute("data-filter");
        currentSlideIndex = 0;
        renderSlide();
      });
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") document.getElementById("next-btn").click();
      if (e.key === "ArrowLeft") document.getElementById("prev-btn").click();
    });

    // Initialize
    renderSlide();
  </script>
