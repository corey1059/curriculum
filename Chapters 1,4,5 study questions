  <script>
    const QUESTIONS = [
      // ================= UNIT U5700.0 (Questions 1 - 20) =================
      {
        id: 1, unit: "U5700.0", skill: "Skill 5700.01 — Perform Housekeeping",
        q: "When staging lumber and stripping form materials during active housekeeping on a job site, what is the immediate mandatory action regarding protruding nails?",
        options: [
          "Leave them in the lumber until the end of the week for bulk removal",
          "Bend them over flush or pull them out immediately before stacking the material",
          "Paint the protruding nails with high-visibility orange spray paint",
          "Stack the boards with the nail points facing upward so workers can see them"
        ],
        answer: 1,
        rationale: "Under Skill 5700.01 and O. Reg. 213/91, protruding nails in scrap or stripped lumber must be removed or bent flush immediately before stacking or disposal to prevent puncture injuries."
      },
      {
